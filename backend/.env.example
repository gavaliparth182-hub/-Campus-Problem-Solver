# Copy this file to .env and fill in your own values
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campus-problem-solver
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Open issues older than this many hours are escalated automatically
ESCALATION_HOURS=48
